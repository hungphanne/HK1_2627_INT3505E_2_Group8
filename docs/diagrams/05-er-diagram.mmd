erDiagram
  USERS { uuid id PK
    string email
    string password_hash
    string role }
  HOTELS { uuid id PK
    string name
    string city
    decimal latitude
    decimal longitude }
  ROOMS { uuid id PK
    uuid hotel_id FK
    int capacity
    bigint price_per_night_vnd }
  BOOKINGS { uuid id PK
    uuid user_id "external reference"
    uuid room_id "external reference"
    date check_in
    date check_out
    string status }
  REVIEWS { uuid id PK
    uuid user_id "external reference"
    uuid hotel_id "external reference"
    string moderation_status }
  BOOKING_OUTBOX { uuid id PK
    uuid aggregate_id
    string event_type }
  REVIEW_OUTBOX { uuid id PK
    uuid aggregate_id FK
    string event_type }
  AI_OUTBOX { uuid id PK
    uuid aggregate_id
    string event_type }
  IDEMPOTENCY_KEYS { string idempotency_key PK
    uuid user_id PK
    string route PK }
  PROCESSED_EVENTS { uuid event_id PK
    string consumer_name PK }
  HOTELS ||--o{ ROOMS : owns
  BOOKINGS ||--o{ BOOKING_OUTBOX : "event for (logical)"
  BOOKINGS ||--o{ IDEMPOTENCY_KEYS : "request for (logical)"
  REVIEWS ||--o{ REVIEW_OUTBOX : "emits"
  USERS ||..o{ BOOKINGS : "user_id (no FK)"
  USERS ||..o{ REVIEWS : "user_id (no FK)"
  ROOMS ||..o{ BOOKINGS : "room_id (no FK)"
  HOTELS ||..o{ REVIEWS : "hotel_id (no FK)"
