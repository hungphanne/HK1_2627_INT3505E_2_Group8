{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review.submitted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "correlation_id",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "review.submitted"
    },
    "event_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "const": "review-service"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "hotel_id",
        "user_id",
        "content",
        "rating",
        "submission_version"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "format": "uuid"
        },
        "hotel_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "submission_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
