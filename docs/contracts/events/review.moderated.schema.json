{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review.moderated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "correlation_id",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "review.moderated"
    },
    "event_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "const": "ai-service"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "submission_event_id",
        "submission_version",
        "sentiment",
        "moderation_status",
        "reason"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "format": "uuid"
        },
        "submission_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "submission_version": {
          "type": "integer",
          "minimum": 1
        },
        "sentiment": {
          "type": "string",
          "enum": [
            "positive",
            "neutral",
            "negative"
          ]
        },
        "moderation_status": {
          "type": "string",
          "enum": [
            "approved",
            "flagged",
            "rejected"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
