{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "booking.cancelled",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "correlation_id",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "booking.cancelled"
    },
    "event_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "const": "booking-service"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booking_id",
        "user_id",
        "room_id",
        "status"
      ],
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "room_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "cancelled"
        }
      }
    }
  }
}
